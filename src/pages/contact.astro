---
import Base from "../layouts/Base.astro";
import Button from "../components/Button.astro";

const phone = "+91 91017 98042";
const phoneHref = "tel:+919101798042";
const whatsapp = "https://wa.me/919101798042";
const email = "concierge@uxavilla.com";

const field =
  "mt-2 block w-full rounded-[16px] border border-gold/40 bg-ivory-bright px-4 py-3.5 text-[15px] tracking-[-0.02em] text-forest placeholder:text-ink-muted/60 transition-colors focus:border-gold focus:outline-none";
const label = "block text-[11px] font-medium uppercase tracking-[0.28em] text-forest";
---

<Base title="Contact — UXA Villa" description="Call the UXA Villa concierge in Tezpur, or leave your number and we'll call you back.">
  <section class="py-20 md:py-28">
    <div class="container-site">
      <div class="grid gap-14 md:grid-cols-12 md:gap-8">
        <!-- Call the concierge -->
        <div class="md:col-span-5">
          <p class="text-[11px] md:text-[12px] font-medium uppercase tracking-[0.28em] text-gold">Call concierge</p>
          <a
            href={phoneHref}
            class="mt-5 block font-serif text-[44px] leading-none tracking-[-0.03em] text-forest transition-colors hover:text-gold md:mt-6 md:text-[64px] lg:text-[72px]"
          >
            {phone}
          </a>
          <p class="mt-6 max-w-[520px] text-[15px] md:text-[16px] leading-relaxed tracking-[-0.02em] text-forest md:mt-7">
            Our concierge answers in person, around the clock. The fastest way
            to arrange a stay or speak about a private buy-out.
          </p>

          <div class="mt-8 flex flex-wrap items-center gap-4 md:mt-10">
            <Button href={phoneHref} variant="cream" class="uppercase tracking-[0.12em]">
              Call now &rarr;
            </Button>
            <Button href={whatsapp} variant="outline" class="uppercase tracking-[0.12em]" target="_blank" rel="noopener noreferrer">
              <svg aria-hidden="true" class="mr-2.5 size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                <path d="M4 20l1.3-3.8A8 8 0 1 1 8.3 19L4 20Z" /><path d="M9.5 9.5c0 3 2 5 5 5l1-1.5-2-1-.8.8a4 4 0 0 1-1.8-1.8l.8-.8-1-2-1.2 1.3Z" />
              </svg>
              WhatsApp
            </Button>
          </div>
          <p class="mt-6 text-[11px] font-medium uppercase tracking-[0.28em] text-gold">
            24 hours &middot; Tezpur, IST
          </p>

          <div class="mt-12 flex items-center gap-2 md:mt-14" aria-hidden="true">
            <span class="h-px w-10 bg-forest/15"></span>
            <span class="size-1.5 rounded-full border border-forest/30"></span>
            <span class="h-px w-10 bg-forest/15"></span>
          </div>

          <ul role="list" class="mt-10 space-y-8 md:mt-12">
            <li class="flex gap-5">
              <svg aria-hidden="true" class="mt-1 size-5 shrink-0 text-gold" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <rect x="3" y="5" width="18" height="14" rx="2" /><path d="m3 7 9 6 9-6" />
              </svg>
              <div>
                <p class={label}>Email</p>
                <a href={`mailto:${email}`} class="mt-1.5 block text-[16px] md:text-[17px] tracking-[-0.02em] text-forest transition-colors hover:text-gold">
                  {email}
                </a>
              </div>
            </li>
            <li class="flex gap-5">
              <svg aria-hidden="true" class="mt-1 size-5 shrink-0 text-gold" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 21s-6-5.3-6-11a6 6 0 0 1 12 0c0 5.7-6 11-6 11Z" /><circle cx="12" cy="10" r="2.3" />
              </svg>
              <div>
                <p class={label}>Our estate</p>
                <p class="mt-1.5 text-[16px] md:text-[17px] leading-snug tracking-[-0.02em] text-forest">
                  Brahmaputra Waterfront,<br />
                  Tezpur, Assam 784001
                </p>
              </div>
            </li>
          </ul>
        </div>

        <!-- Request a callback -->
        <div class="md:col-span-7">
          <form id="callback" class="rounded-[24px] border border-gold/30 bg-ivory-bright p-6 md:p-10" novalidate>
            <p class="text-[11px] md:text-[12px] font-medium uppercase tracking-[0.28em] text-gold">Or, request a callback</p>
            <h1 class="font-serif tracking-[-0.03em] text-[36px] leading-[1.06] md:text-[44px] mt-4 text-forest">
              We&rsquo;ll Call You.
            </h1>
            <p class="mt-4 max-w-[640px] text-[15px] md:text-[16px] leading-relaxed tracking-[-0.02em] text-forest">
              Leave your number and a window that suits you. Our concierge will
              call back, usually within the hour.
            </p>
            <div class="mt-7 flex items-center gap-2" aria-hidden="true">
              <span class="h-px w-10 bg-forest/15"></span>
              <span class="size-1.5 rounded-full border border-forest/30"></span>
              <span class="h-px w-10 bg-forest/15"></span>
            </div>

            <div class="mt-8 grid gap-6 sm:grid-cols-2">
              <div>
                <label for="name" class={label}>Full name</label>
                <input id="name" name="name" type="text" autocomplete="name" required placeholder="Your name" class={field} />
              </div>
              <div>
                <label for="phone" class={label}>Phone number</label>
                <input id="phone" name="phone" type="tel" autocomplete="tel" required placeholder="+91 98765 43210" class={field} />
              </div>
              <div>
                <label for="checkin" class={label}>Preferred check-in</label>
                <input id="checkin" name="checkin" type="date" class={field} />
              </div>
              <div>
                <label for="checkout" class={label}>Preferred check-out</label>
                <input id="checkout" name="checkout" type="date" class={field} />
              </div>
              <div class="sm:col-span-2">
                <label for="window" class={label}>Best time to call</label>
                <select id="window" name="window" class={field}>
                  <option value="Anytime">Anytime</option>
                  <option value="Morning (8am – 12pm IST)">Morning (8am &ndash; 12pm IST)</option>
                  <option value="Afternoon (12pm – 5pm IST)">Afternoon (12pm &ndash; 5pm IST)</option>
                  <option value="Evening (5pm – 9pm IST)">Evening (5pm &ndash; 9pm IST)</option>
                </select>
              </div>
              <div class="sm:col-span-2">
                <label for="notes" class={label}>
                  Notes <span class="normal-case tracking-[-0.01em] text-ink-muted">(optional)</span>
                </label>
                <textarea id="notes" name="notes" rows="4" placeholder="Anything we should know before we call…" class={field}></textarea>
              </div>
            </div>

            <div class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-4">
              <Button href="#" variant="dark" class="js-submit uppercase tracking-[0.12em]">
                Request a callback &rarr;
              </Button>
              <p class="text-[13px] tracking-[-0.02em] text-ink-muted">
                Sent to the concierge on WhatsApp.
              </p>
            </div>
            <p id="callback-note" class="mt-4 hidden text-[13px] tracking-[-0.02em] text-gold" role="status"></p>
          </form>
        </div>
      </div>
    </div>
  </section>

  <script>
    // Callback requests are handed to the concierge on WhatsApp, prefilled
    // with the form's details — no server is involved.
    const form = document.getElementById("callback") as HTMLFormElement | null;
    const submit = form?.querySelector<HTMLAnchorElement>(".js-submit");
    const note = document.getElementById("callback-note");
    if (form && submit && note) {
      const val = (id: string) => (form.querySelector<HTMLInputElement>(`#${id}`)?.value || "").trim();
      const send = (e: Event) => {
        e.preventDefault();
        const missing = !val("name") ? "name" : !val("phone") ? "phone" : "";
        if (missing) {
          note.textContent =
            missing === "name" ? "Please add your name so we know who to ask for." : "Please add the number we should call.";
          note.classList.remove("hidden");
          form.querySelector<HTMLInputElement>(`#${missing}`)?.focus();
          return;
        }
        note.classList.add("hidden");
        const lines = ["Hello UXA Villa, please call me back about a stay.", "", `Name: ${val("name")}`, `Phone: ${val("phone")}`];
        if (val("checkin") || val("checkout")) lines.push(`Dates: ${val("checkin") || "?"} to ${val("checkout") || "?"}`);
        lines.push(`Best time to call: ${val("window")}`);
        if (val("notes")) lines.push("", val("notes"));
        window.open(`https://wa.me/919101798042?text=${encodeURIComponent(lines.join("\n"))}`, "_blank", "noopener");
      };
      submit.addEventListener("click", send);
      form.addEventListener("submit", send);
    }
  </script>
</Base>
