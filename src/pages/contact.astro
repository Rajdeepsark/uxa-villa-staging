---
import Base from "../layouts/Base.astro";
import Button from "../components/Button.astro";

const phone = "+91 91017 98042";
const phoneHref = "tel:+919101798042";
const whatsapp = "https://wa.me/919101798042";
const email = "concierge@uxavilla.com";

const field =
  "mt-2 block w-full rounded-[8px] border border-ivory/20 bg-ivory/[0.06] px-4 py-3.5 text-[15px] tracking-[-0.02em] text-ivory placeholder:text-ivory/40 transition-colors focus:border-gold-light focus:outline-none [color-scheme:dark]";
const label = "block text-[11px] font-medium uppercase tracking-[0.2em] text-ivory";
---

<Base title="Contact — UXA Villa" description="Call the UXA Villa concierge in Tezpur, or leave your number and we'll call you back.">
  <section class="relative overflow-hidden bg-forest-deep py-20 text-ivory md:py-28 lg:py-32">
    <!-- Ground — the buy-out card's forest gradient with the fine dot grain -->
    <div
      id="contact-ground"
      aria-hidden="true"
      class="absolute inset-0 bg-[radial-gradient(120%_85%_at_50%_112%,#27483e_0%,#18291f_42%,#0f1a15_100%)]"
    >
    </div>
    <div
      aria-hidden="true"
      class="absolute inset-0 opacity-[0.07] [background-image:radial-gradient(rgba(255,255,255,0.5)_0.5px,transparent_0.5px)] [background-size:3px_3px]"
    >
    </div>
    <div class="container-site relative">
      <div class="grid gap-16 md:grid-cols-12 md:gap-8 lg:gap-12">
        <!-- Call the concierge -->
        <div class="flex flex-col md:col-span-5">
          <p class="text-[11px] md:text-[12px] font-medium uppercase tracking-[0.28em] text-gold-light">Call concierge</p>
          <a
            href={phoneHref}
            class="mt-5 block font-serif text-[44px] leading-none tracking-[-0.03em] text-ivory transition-colors hover:text-gold-light md:mt-6 md:text-[60px] lg:text-[72px]"
          >
            {phone}
          </a>
          <p class="mt-6 max-w-[460px] text-[15px] md:text-[16px] leading-relaxed tracking-[-0.02em] text-ivory/65 md:mt-7">
            Our concierge answers in person, around the clock. The fastest way
            to arrange a stay or speak about a private buy-out.
          </p>

          <div class="mt-8 flex flex-wrap items-center gap-4 md:mt-10">
            <Button href={phoneHref} variant="cream" class="uppercase tracking-[0.12em]">
              Call now &rarr;
            </Button>
            <Button href={whatsapp} variant="outline" class="!border-gold-light !text-gold-light hover:!bg-gold-light/10 uppercase tracking-[0.12em]" target="_blank" rel="noopener noreferrer">
              <svg aria-hidden="true" class="mr-2.5 size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                <path d="M4 20l1.3-3.8A8 8 0 1 1 8.3 19L4 20Z" /><path d="M9.5 9.5c0 3 2 5 5 5l1-1.5-2-1-.8.8a4 4 0 0 1-1.8-1.8l.8-.8-1-2-1.2 1.3Z" />
              </svg>
              WhatsApp
            </Button>
          </div>
          <p class="mt-5 text-[11px] font-medium uppercase tracking-[0.28em] text-gold-light">
            24 hours &middot; Tezpur, IST
          </p>

          <dl class="mt-12 grid gap-7 sm:grid-cols-2 md:mt-auto md:pt-12">
            <div>
              <dt class="text-[11px] font-medium uppercase tracking-[0.2em] text-ivory/65">Email</dt>
              <dd class="mt-2">
                <a href={`mailto:${email}`} class="text-[15px] md:text-[16px] tracking-[-0.02em] text-ivory transition-colors hover:text-gold">
                  {email}
                </a>
              </dd>
            </div>
            <div>
              <dt class="text-[11px] font-medium uppercase tracking-[0.2em] text-ivory/65">Our estate</dt>
              <dd class="mt-2 text-[15px] md:text-[16px] leading-snug tracking-[-0.02em] text-ivory">
                Brahmaputra Waterfront,<br />
                Tezpur, Assam 784001
              </dd>
            </div>
          </dl>
        </div>

        <!-- Request a callback -->
        <div class="md:col-span-6 md:col-start-7">
          <form id="callback" novalidate>
            <p class="text-[11px] md:text-[12px] font-medium uppercase tracking-[0.28em] text-gold-light">Or, request a callback</p>
            <h1 class="font-serif tracking-[-0.03em] text-[36px] leading-[1.06] md:text-[44px] mt-4 text-ivory">
              We&rsquo;ll Call You.
            </h1>
            <p class="mt-4 max-w-[520px] text-[15px] md:text-[16px] leading-relaxed tracking-[-0.02em] text-ivory/65">
              Leave your number and a window that suits you. Our concierge will
              call back, usually within the hour.
            </p>

            <div class="mt-10 grid gap-6 sm:grid-cols-2">
              <div>
                <label for="name" class={label}>Full name</label>
                <input id="name" name="name" type="text" autocomplete="name" required placeholder="Your name" class={field} />
              </div>
              <div>
                <label for="phone" class={label}>Phone number</label>
                <input id="phone" name="phone" type="tel" autocomplete="tel" required placeholder="+91 98765 43210" class={field} />
              </div>
              <div>
                <label for="checkin" class={label}>Preferred check-in</label>
                <input id="checkin" name="checkin" type="date" class={field} />
              </div>
              <div>
                <label for="checkout" class={label}>Preferred check-out</label>
                <input id="checkout" name="checkout" type="date" class={field} />
              </div>
              <div class="sm:col-span-2">
                <label for="window" class={label}>Best time to call</label>
                <select id="window" name="window" class={field}>
                  <option value="Anytime">Anytime</option>
                  <option value="Morning (8am – 12pm IST)">Morning (8am &ndash; 12pm IST)</option>
                  <option value="Afternoon (12pm – 5pm IST)">Afternoon (12pm &ndash; 5pm IST)</option>
                  <option value="Evening (5pm – 9pm IST)">Evening (5pm &ndash; 9pm IST)</option>
                </select>
              </div>
              <div class="sm:col-span-2">
                <label for="notes" class={label}>
                  Notes <span class="normal-case tracking-[-0.01em] text-ivory/65">(optional)</span>
                </label>
                <textarea id="notes" name="notes" rows="4" placeholder="Anything we should know before we call…" class={field}></textarea>
              </div>
            </div>

            <div class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-4 md:mt-10">
              <Button href="#" variant="dark" class="js-submit !bg-ivory !text-forest hover:!bg-cream uppercase tracking-[0.12em]">
                Request a callback &rarr;
              </Button>
              <p class="flex items-center gap-2 text-[13px] tracking-[-0.02em] text-ivory/65">
                <svg aria-hidden="true" class="size-3.5 shrink-0 text-gold-light" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="5" y="11" width="14" height="10" rx="2" /><path d="M8 11V8a4 4 0 0 1 8 0v3" />
                </svg>
                Your number stays with the concierge &mdash; never shared
              </p>
            </div>
            <p id="callback-note" class="mt-4 hidden text-[13px] tracking-[-0.02em] text-gold-light" role="status"></p>
          </form>
        </div>
      </div>
    </div>
  </section>

  <script>
    // Callback requests are handed to the concierge on WhatsApp, prefilled
    // with the form's details — no server is involved.
    const form = document.getElementById("callback") as HTMLFormElement | null;
    const submit = form?.querySelector<HTMLAnchorElement>(".js-submit");
    const note = document.getElementById("callback-note");
    if (form && submit && note) {
      const val = (id: string) => (form.querySelector<HTMLInputElement>(`#${id}`)?.value || "").trim();
      const send = (e: Event) => {
        e.preventDefault();
        const missing = !val("name") ? "name" : !val("phone") ? "phone" : "";
        if (missing) {
          note.textContent =
            missing === "name" ? "Please add your name so we know who to ask for." : "Please add the number we should call.";
          note.classList.remove("hidden");
          form.querySelector<HTMLInputElement>(`#${missing}`)?.focus();
          return;
        }
        note.classList.add("hidden");
        const lines = ["Hello UXA Villa, please call me back about a stay.", "", `Name: ${val("name")}`, `Phone: ${val("phone")}`];
        if (val("checkin") || val("checkout")) lines.push(`Dates: ${val("checkin") || "?"} to ${val("checkout") || "?"}`);
        lines.push(`Best time to call: ${val("window")}`);
        if (val("notes")) lines.push("", val("notes"));
        window.open(`https://wa.me/919101798042?text=${encodeURIComponent(lines.join("\n"))}`, "_blank", "noopener");
      };
      submit.addEventListener("click", send);
      form.addEventListener("submit", send);
    }
  </script>
</Base>
