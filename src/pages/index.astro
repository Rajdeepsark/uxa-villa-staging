        <script>
          const estateCard = document.getElementById("estate-card");
          const estateTrail = document.getElementById("estate-trail");
          const finePointer = window.matchMedia("(pointer: fine)").matches;
          const noMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
          if (estateCard && estateTrail && finePointer && !noMotion) {
            const SRCS = [
              "/images/villa/entrance.jpg",
              "/images/villa/master-bedroom.jpg",
              "/images/villa/living-room.jpg",
              "/images/villa/bedroom-suite.jpg",
              "/images/villa/lounge.jpg",
              "/images/villa/guest-bedroom.jpg",
              "/images/villa/evening-lounge.jpg",
            ];
            const STEP = 180; // px of pointer travel between cards
            const MAX = 3; // cards alive at once
            const HOLD = 850; // ms before a card starts to fade
            const LIFE = 1500; // ms until it is removed
            SRCS.forEach((src) => { const im = new Image(); im.src = src; });

            let last: { x: number; y: number } | null = null;
            let next = 0;
            const live: HTMLElement[] = [];

            function spawn(x: number, y: number) {
              const card = document.createElement("div");
              card.className = "trail-card";
              const img = document.createElement("img");
              img.src = SRCS[next++ % SRCS.length];
              img.alt = "";
              card.appendChild(img);
              card.style.left = `${x}px`;
              card.style.top = `${y}px`;
              card.style.setProperty("--rot", `${(Math.random() * 16 - 8).toFixed(1)}deg`);
              estateTrail.appendChild(card);
              live.push(card);
              while (live.length > MAX) live.shift()?.remove();
              requestAnimationFrame(() => card.classList.add("is-in"));
              window.setTimeout(() => card.classList.add("is-out"), HOLD);
              window.setTimeout(() => {
                card.remove();
                const k = live.indexOf(card);
                if (k > -1) live.splice(k, 1);
              }, LIFE);
            }

            estateCard.addEventListener("pointermove", (e) => {
              const r = estateTrail.getBoundingClientRect();
              const x = e.clientX - r.left;
              const y = e.clientY - r.top;
              if (last && Math.hypot(x - last.x, y - last.y) < STEP) return;
              last = { x, y };
              spawn(x, y);
            });
            estateCard.addEventListener("pointerleave", () => { last = null; });
          }
        </script>

