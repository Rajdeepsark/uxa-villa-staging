      <!-- Scroll parallax for every photograph.
           Frames: [data-parallax-img] and every gallery card. The photo
           inside is oversized (1 + 2·strength of the frame height) and
           translated as the frame crosses the viewport, so it moves at
           ~80% of scroll speed. Photo-backed sections ([data-parallax-bg])
           do the same through background-position. Off for reduced motion. -->
      <script>
        const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
        if (!reducedMotion) {
          const DEFAULT_STRENGTH = 0.2; // ±20% of the frame height across the traversal
          const clamp01 = (v: number) => Math.max(-1, Math.min(1, v));

          type Frame = { el: HTMLElement; img: HTMLElement; strength: number };
          let frames: Frame[] = [];
          let bgs: HTMLElement[] = [];

          function collect() {
            const els = document.querySelectorAll<HTMLElement>("[data-parallax-img], .ticker-card");
            frames = [];
            els.forEach((el) => {
              const img = el.querySelector<HTMLElement>(":scope > img");
              if (!img) return;
              const strength = parseFloat(el.dataset.parallaxImg || "") || DEFAULT_STRENGTH;
              img.style.height = `${(1 + 2 * strength) * 100}%`;
              img.style.willChange = "transform";
              frames.push({ el, img, strength });
            });
            bgs = Array.from(document.querySelectorAll<HTMLElement>("[data-parallax-bg]"));
          }

          function update() {
            const vh = window.innerHeight;
            for (const f of frames) {
              const r = f.el.getBoundingClientRect();
              if (r.bottom < -100 || r.top > vh + 100) continue;
              // +1 entering at the bottom … −1 leaving at the top
              const p = clamp01((r.top + r.height / 2 - vh / 2) / (vh / 2 + r.height / 2));
              const ty = -f.strength * r.height * (1 - p);
              f.img.style.transform = `translate3d(0, ${ty.toFixed(1)}px, 0)`;
            }
            for (const el of bgs) {
              const r = el.getBoundingClientRect();
              if (r.bottom < -100 || r.top > vh + 100) continue;
              const p = clamp01((r.top + r.height / 2 - vh / 2) / (vh / 2 + r.height / 2));
              el.style.backgroundPositionY = `${(50 - p * 30).toFixed(2)}%`;
            }
          }

          function loop() {
            if (!document.hidden) update();
            requestAnimationFrame(loop);
          }

          // The gallery clones its cards after load; re-collect once it has built.
          collect();
          window.addEventListener("load", collect);
          const track = document.getElementById("gallery-track");
          if (track) new MutationObserver(collect).observe(track, { childList: true });
          window.addEventListener("resize", collect);
          requestAnimationFrame(loop);
        }
      </script>

</Base>
