---
import Base from "../layouts/Base.astro";
import Button from "../components/Button.astro";
---

<Base title="UXA Villa">

      <!-- ═══════════════ HERO ═══════════════
           Full-bleed architectural photograph. Centered headline,
           description and CTAs, with the information line at the foot,
           all on the shared 1280px grid.
           Drop the real villa photo in as public/hero.jpg; the Unsplash
           layer beneath it is only a placeholder. -->
      <section
        id="hero"
        class="relative h-[calc(100vh-104px)] min-h-[680px] overflow-hidden bg-forest-deep md:h-[calc(100vh-112px)]"
      >
        <!-- Hero visual — the photograph plus its forest-tinted overlay.
             This single wrapper is what travels down into the gallery
             ticker in the next section (see the script there); it is
             never duplicated. -->
        <div id="hero-visual" class="absolute inset-0 overflow-hidden" data-parallax-img="0.12">
          <img
            src="/hero.jpg"
            onerror="this.onerror=null;this.src='https://images.unsplash.com/photo-1571896349842-33c89424de2d?q=80&w=2400&auto=format&fit=crop'"
            alt="UXA Villa at dusk — pool, palms and warm architectural light"
            class="h-full w-full object-cover"
            fetchpriority="high"
          />
          <div
            aria-hidden="true"
            class="hero-shade absolute inset-0 bg-[linear-gradient(to_bottom,rgba(18,28,23,0.55)_0%,rgba(18,28,23,0.55)_55%,rgba(18,28,23,0.66)_100%)]"
          >
          </div>
        </div>

        <!-- Fine dotted grain texture -->
        <div
          aria-hidden="true"
          class="absolute inset-0 opacity-[0.07] [background-image:radial-gradient(rgba(255,255,255,0.5)_0.5px,transparent_0.5px)] [background-size:3px_3px]"
        >
        </div>

        <!-- Headline, description and CTAs — centred in the hero, both axes -->
        <div class="absolute inset-0 z-10 flex items-center justify-center">
          <div class="container-site">
            <h1
              class="font-serif tracking-[-0.03em] text-[44px] leading-[1.06] md:text-[clamp(52px,4.8vw,68px)] mx-auto max-w-[720px] text-center text-ivory"
            >
              A Sanctuary Where the<br />
              <span class="u-editorial-light">Brahmaputra</span> Whispers.
            </h1>
            <p class="mx-auto mt-5 max-w-[560px] text-center text-[17px] leading-[1.35] tracking-[-0.02em] md:mt-6 md:text-[21px] md:leading-[1.25]">
              <span class="font-medium text-ivory">Experience a dialogue</span>
              <span class="font-light text-ivory/70">
                between Assamese heritage and modern minimalist luxury. Our
                secluded villa homestay offers a rhythmic retreat curated for
                the discerning traveler.</span
              >
            </p>
            <div class="mt-7 flex flex-wrap items-center justify-center gap-5 md:mt-9 md:gap-7">
              <Button href="#contact" variant="cream">
                RESERVE A STAY &rarr;
              </Button>
              <Button href="#estate" variant="ghost">
                EXPLORE THE ESTATE &rarr;
              </Button>
            </div>
          </div>
        </div>

        <!-- Information row at the foot of the hero -->
        <div class="absolute inset-x-0 bottom-[4vh] z-10">
          <div class="container-site">
            <div>
              <div
                class="flex flex-col gap-3 text-[14px] font-medium tracking-[0.01em] text-ivory md:flex-row md:items-center md:justify-between md:gap-8 md:text-[15px]"
              >
                <p>Tezpur &middot; Assam &middot; India</p>
                <p class="hidden lg:block">5 Suites</p>
                <a
                  href="#suites"
                  class="group flex items-center gap-3.5 text-ivory transition-opacity hover:opacity-70"
                >
                  <span
                    class="flex h-8 w-8 items-center justify-center rounded-full border border-ivory/45 text-[12px] transition-transform duration-300 group-hover:translate-x-[3px]"
                    aria-hidden="true"
                  >
                    &rarr;
                  </span>
                  Property details
                </a>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- 1 · OUR NARRATIVE — floating, gently tilted photographs arranged
           on a shallow arc across the full viewport, with centered editorial
           content below. The arc is a property of the *screen*: a card's
           height and scale depend on how far it currently is from the
           viewport centre (highest and largest at centre, lower and smaller
           toward the edges), so the composition reads the same whether it
           is resting or travelling as an infinite marquee.
           MAIN is an empty slot: on scroll the hero's own image element
           (#hero-visual) travels down from the hero and docks into it while
           MAIN sits featured — large and elevated — at the centre. Only once
           it has settled does the marquee begin. The hero image is never
           duplicated: repeated groups fill the MAIN position with the
           entrance photograph (data-main-alt). Cards are laid out in DOM order at one uniform
           spacing and share one size; each declares only its track label.
           See the script at the end of the section. -->
      <section id="our-story" class="relative overflow-hidden pt-12 pb-24 md:pt-16 md:pb-32">
        <!-- Gallery — full-bleed, deliberately not constrained to the 1280px grid -->
        <div id="gallery-ticker" class="relative h-[420px] w-full md:h-[560px]">
          <!-- The curved track line and faint grid — drawn by the script
               from the same arc function that places the cards. -->
          <svg
            id="gallery-lines"
            aria-hidden="true"
            class="pointer-events-none absolute inset-0 h-full w-full"
            fill="none"
            stroke="#1b2a22"
            stroke-width="1"
          >
            <path id="gallery-grid" stroke-opacity="0.04" />
            <path id="gallery-track-line" stroke-opacity="0.14" />
          </svg>
          <!-- Cards are laid out in DOM order at one uniform spacing, centred
               on MAIN; each declares only its track label. All cards share
               one size; position and rotation come from the shared arc. -->
          <div id="gallery-track" class="absolute inset-0 opacity-0 transition-opacity duration-700">
            <figure class="ticker-card" data-label="The Lounge">
              <img
                src="/images/villa/lounge.jpg"
                alt="The lounge — evening light and the tea-garden screen"
                loading="lazy"
              />
            </figure>
            <figure class="ticker-card" data-label="Master Bedroom">
              <img
                src="/images/villa/master-bedroom.jpg"
                alt="Master bedroom with fluted timber wall"
                loading="lazy"
              />
            </figure>
            <figure class="ticker-card" data-label="Evening Lounge">
              <img
                src="/images/villa/evening-lounge.jpg"
                alt="The lounge at night"
                loading="lazy"
              />
            </figure>
            <!-- MAIN — the hero slot. data-main-alt / data-label-alt are used
                 in repeated groups so the marquee has no gap and no hero copy. -->
            <figure
              id="hero-slot"
              class="ticker-card ticker-card--main"
              data-label="The Villa"
              data-label-alt="The Entrance"
              data-main-src="/images/villa/entrance.jpg"
              data-main-alt="/images/villa/entrance.jpg"
            >
            </figure>
            <figure class="ticker-card" data-label="Bedroom Suite">
              <img
                src="/images/villa/bedroom-suite.jpg"
                alt="Bedroom suite with warm cove lighting"
                loading="lazy"
              />
            </figure>
            <figure class="ticker-card" data-label="Guest Bedroom">
              <img
                src="/images/villa/guest-bedroom.jpg"
                alt="Guest bedroom with seating"
                loading="lazy"
              />
            </figure>
            <figure class="ticker-card" data-label="The Living Room">
              <img
                src="/images/villa/living-room.jpg"
                alt="The living room opening onto the balcony"
                loading="lazy"
              />
            </figure>
          </div>
        </div>

        <div class="container-site">
          <!-- Centered content -->
          <div class="relative z-20 mx-auto mt-4 max-w-[620px] text-center md:mt-6">
            <p class="text-[11px] md:text-[12px] font-medium uppercase tracking-[0.28em] text-gold">
              Our Narrative
            </p>
            <h2 class="font-serif tracking-[-0.03em] text-[40px] leading-[1.08] md:text-[56px] mt-5 text-forest md:mt-6">
              Verdant Sophistication.
            </h2>
            <p class="mt-6 text-[14px] md:text-[15px] leading-relaxed tracking-[-0.02em] text-ink-muted md:mt-8">
              Inspired by the emerald tea gardens and the serene flow of the
              river, UXA Villa Homestay is more than a destination. It is a
              curated gallery of local craftsmanship&mdash;from Muga silk
              textiles to hand-woven cane furniture&mdash;balanced with the
              structure of modern architecture.
            </p>
            <blockquote class="mx-auto mt-8 max-w-[520px] text-[15px] md:text-[16px] leading-relaxed tracking-[-0.02em] text-forest md:mt-10">
              &ldquo;The design transitions from Mediterranean minimalism to a
              narrative of Assamese Heritage Luxury, evoking the atmosphere of
              a secluded villa overlooking the Brahmaputra.&rdquo;
            </blockquote>
            <div class="mt-10 md:mt-12">
              <Button href="#contact" variant="dark">
                RESERVE YOUR RETREAT &rarr;
              </Button>
            </div>
          </div>

        </div>

        <script>
          const hero = document.getElementById("hero");
          const visual = document.getElementById("hero-visual");
          const shade = visual?.querySelector<HTMLElement>(".hero-shade");
          const slot = document.getElementById("hero-slot");
          const ticker = document.getElementById("gallery-ticker");
          const track = document.getElementById("gallery-track");
          const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

          if (slot && ticker && track) {
            // No hero photograph to receive: MAIN is filled up front and
            // starts settled in the row.
            if (!visual) {
              const img = document.createElement("img");
              img.src = slot.dataset.mainSrc || slot.dataset.mainAlt || "";
              img.alt = "The entrance at dusk";
              img.loading = "lazy";
              slot.appendChild(img);
              slot.classList.add("is-filled");
            }
            // ── Arc composition + infinite ticker ──────────────────────
            // Geometry is relative to the frame width W (the viewport, with
            // a floor so phones still get a generous composition). Each card
            // declares its place in the sequence (data-x, % of W), its tilt
            // and its aspect ratio. A card's vertical position and scale on
            // screen depend on u — its current distance from the viewport
            // centre as a fraction of W/2 — so the arc belongs to the screen,
            // not the card: highest and largest at centre, lower and smaller
            // toward the edges. MAIN (the hero slot) is featured — large and
            // elevated — while at the centre and eases down onto the arc as
            // it departs. The sequence is repeated as whole groups (MAIN in
            // repeats becomes an ordinary card showing the villa exterior;
            // the hero image exists exactly once) and a card that fully
            // leaves the left edge is moved one cycle to the right. The
            // ticker only runs once the hero image has docked and settled
            // (see the frame loop); it never moves during the transition.
            const CARD_ASPECT = 0.82; // height / width, shared by every card and the featured frame
            const SPEED = 60; // px per second
            const HOVER_SLOW = 0.35; // speed multiplier while the pointer is over the gallery
            let hover = 0; // eases 0 → 1 while hovered
            const SETTLE_MS = 450; // stillness after docking before motion begins
            const RAMP_MS = 1400; // ease-in from rest to full speed
            const SPREAD_START = 0.72; // surrounding cards fan out from here to 1 as the hero docks
            const SHRINK_MS = 900; // MAIN eases from featured size into the row before motion
            type Item = {
              el: HTMLElement;
              label: HTMLElement; // track label printed beneath the card
              dot: HTMLElement; // separator dot halfway to the next item
              dotDx: number; // dot's offset from the card centre
              featured: boolean; // the hero slot itself
              w: number; // base width (before arc scale)
              h: number;
              base: number; // settled centre x within the repeating sequence
              rx: number; // settled offset from its group's MAIN
              x: number; // current centre x
            };
            let items: Item[] = [];
            let cycle = 0;
            let originX = 0;
            let spread = 1;
            let featuredM = visual ? 0 : 1; // 0 = MAIN featured (large, elevated) · 1 = settled into the row
            let dockShrunk = !visual; // MAIN was already in the row when it (re)docked
            // Frame geometry, recomputed in build()
            let W = 1440;
            let MAIN_W = 0;
            let MAIN_H = 0;
            let CARD_W = 0;
            let MAIN_CY = 0; // featured MAIN centre y
            let ARC_TOP = 0; // arc centre y for a card at the viewport centre
            let ARC = 0; // how far the arc drops by the frame edge
            let LABEL_DY = 0; // labels sit this far below the arc centre line
            const lineEl = document.getElementById("gallery-track-line");
            const gridEl = document.getElementById("gallery-grid");

            const children = () => Array.from(track.children) as HTMLElement[];
            // The shared curved track: one shallow parabola in screen space.
            // For a point whose centre is at screen x it returns the height on
            // the curve and the tangent angle. Cards, labels, dots and the
            // drawn line are all placed with this single function, so they
            // stay on the same curve while the marquee moves.
            function arcAt(x: number) {
              const u = clamp((x - originX) / (W / 2), -1.4, 1.4); // signed, −1..1 across the frame
              const y = ARC_TOP + ARC * u * u;
              const rot = (Math.atan((2 * ARC * u) / (W / 2)) * 180) / Math.PI; // tangent
              return { u, au: Math.abs(u), y, rot };
            }

            function setPos(el: HTMLElement, x: number, y: number, rot: number) {
              el.style.setProperty("--x", `${x.toFixed(2)}px`);
              el.style.setProperty("--y", `${y.toFixed(2)}px`);
              el.style.setProperty("--r", `${rot.toFixed(3)}deg`);
            }

            function place(i: Item) {
              const x = i.x - i.rx * (1 - spread);
              const a = arcAt(x);
              let y = a.y;
              let s = 1;
              let z = 20 - Math.round(a.au * 10);
              if (i.featured) {
                // Featured (large, elevated) on arrival, then eased down into
                // the row at the same width as every other card before the
                // ticker starts. featuredM is driven by time in the frame loop.
                s = lerp(1, CARD_W / MAIN_W, featuredM);
                y = lerp(MAIN_CY, a.y, featuredM);
                if (featuredM < 1) z = 30;
              }
              setPos(i.el, x, y, a.rot);
              i.el.style.setProperty("--s", s.toFixed(4));
              i.el.style.zIndex = String(z);
              // Label printed along the track beneath the card, and the dot
              // halfway to the next item — both on the same curve.
              setPos(i.label, x, a.y + LABEL_DY, a.rot);
              const dx = x + i.dotDx;
              const d = arcAt(dx);
              setPos(i.dot, dx, d.y + LABEL_DY, d.rot);
            }
            const placeAll = () => items.forEach(place);

            function build() {
              track
                .querySelectorAll("[data-clone], .ticker-label, .ticker-dot")
                .forEach((n) => n.remove());
              const vw = ticker.clientWidth;
              W = Math.max(vw, 960);
              MAIN_W = 0.3 * W;
              MAIN_H = MAIN_W * CARD_ASPECT;
              CARD_W = 0.15 * W;
              ARC = 0.058 * W; // very shallow: ~83px drop at the frame edge on 1440
              MAIN_CY = 12 + MAIN_H / 2;
              ARC_TOP = MAIN_CY + MAIN_H / 2 + 0.005 * W;
              originX = vw / 2;

              const authored = children();
              const n = authored.length;
              const slotIdx = authored.indexOf(slot);
              const step = CARD_W + 0.03 * W; // uniform centre-to-centre spacing (~43px gap on 1440)
              const pitch = n * step; // repeated groups continue at exactly the same spacing
              const groups = Math.max(2, Math.ceil((vw + pitch) / pitch));

              // Repeat the sequence; MAIN in repeats is an ordinary card
              // showing the alt image and label.
              for (let g = 1; g < groups; g++) {
                for (const el of authored) {
                  const clone = el.cloneNode(true) as HTMLElement;
                  clone.dataset.clone = "";
                  clone.dataset.group = String(g);
                  clone.removeAttribute("id");
                  clone.setAttribute("aria-hidden", "true");
                  if (el === slot) {
                    clone.classList.remove("ticker-card--main");
                    clone.querySelectorAll("img").forEach((n) => n.remove());
                    clone.dataset.label = slot.dataset.labelAlt || slot.dataset.label || "";
                    const img = document.createElement("img");
                    img.src = slot.dataset.mainAlt || "";
                    img.alt = "";
                    img.loading = "lazy";
                    clone.appendChild(img);
                  }
                  track.appendChild(clone);
                }
              }

              const cards = children();
              items = cards.map((el, k) => {
                const g = parseInt(el.dataset.group || "0", 10);
                const featured = el === slot;
                const w = featured ? MAIN_W : CARD_W;
                const h = w * CARD_ASPECT;
                const rx = ((k % n) - slotIdx) * step; // offset from the group's MAIN, in DOM order
                el.style.width = `${w}px`;
                el.style.height = `${h}px`;
                // Track label + separator dot, printed along the same curve.
                const label = document.createElement("span");
                label.className =
                  "ticker-label text-[11px] md:text-[12px] font-medium uppercase tracking-[0.28em] text-gold";
                label.textContent = el.dataset.label || "";
                if (el.hasAttribute("aria-hidden")) label.setAttribute("aria-hidden", "true");
                const dot = document.createElement("span");
                dot.className = "ticker-dot";
                dot.setAttribute("aria-hidden", "true");
                // Astro scopes this section's <style> by attribute; elements
                // created here need the same attribute for those rules to apply.
                for (const attr of Array.from(el.attributes)) {
                  if (attr.name.startsWith("data-astro-cid")) {
                    label.setAttribute(attr.name, attr.value);
                    dot.setAttribute(attr.name, attr.value);
                  }
                }
                track.append(label, dot);
                return { el, label, dot, dotDx: 0, featured, w, h, base: g * pitch + rx, rx, x: 0 };
              });
              cycle = groups * pitch;

              // Each dot sits halfway to the next item in the sequence (the
              // last item's dot reaches round to the first of the next cycle).
              const order = [...items].sort((a, b) => a.base - b.base);
              order.forEach((it, k) => {
                const next = order[(k + 1) % order.length];
                const gap = k + 1 < order.length ? next.base - it.base : cycle + next.base - it.base;
                it.dotDx = gap / 2;
              });

              // Labels sit below the tallest card; the drawn track line runs
              // between the cards and the labels. Container fits the lowest
              // point of the curve.
              const tallest = Math.max(...items.filter((i) => !i.featured).map((i) => i.h));
              LABEL_DY = tallest / 2 + 44;
              const H = ARC_TOP + ARC + LABEL_DY + 12;
              ticker.style.height = `${H}px`;
              if (lineEl && gridEl) {
                const lineC = ARC_TOP + LABEL_DY - 26; // line's y at the centre
                const x1 = -100;
                const x2 = vw + 100;
                const y1 = lineC + ARC * Math.pow((x1 - originX) / (W / 2), 2);
                lineEl.setAttribute("d", `M${x1} ${y1} Q${originX} ${2 * lineC - y1} ${x2} ${y1}`);
                gridEl.setAttribute(
                  "d",
                  `M${0.25 * vw} 0V${H}M${0.5 * vw} 0V${H}M${0.75 * vw} 0V${H}`
                );
              }
              recenter();
              track.style.opacity = "1";
            }

            // Return every card to its starting position, MAIN centred.
            // Used while the section is out of view so the next docking
            // lands exactly in the middle again.
            function recenter() {
              for (const i of items) i.x = originX + i.base;
              featuredM = visual ? 0 : 1;
              placeAll();
            }

            function advance(dt: number) {
              for (const i of items) {
                i.x -= SPEED * dt;
                if (i.x + i.w / 2 < -240) i.x += cycle;
              }
              placeAll();
            }

            // ── Hero image → ticker slot ───────────────────────────────
            // Progress runs from the hero's bottom edge reaching mid-viewport
            // (0) to the slot's centre reaching mid-viewport (1). In between,
            // #hero-visual is position:fixed and its rect is interpolated
            // between the live hero rect and the live slot rect; at 1 the
            // same element is re-parented into the slot.
            type State = "hero" | "moving" | "docked";
            let state: State = visual ? "hero" : "docked";
            let dockedAt = 0; // timestamp of the most recent docking
            const clamp = (v: number, a: number, b: number) => Math.max(a, Math.min(b, v));
            const lerp = (a: number, b: number, t: number) => a + (b - a) * t;
            const ease = (t: number) =>
              t < 0.5 ? 2 * t * t : 1 - Math.pow(-2 * t + 2, 2) / 2;

            function setState(next: State) {
              if (next === state) return;
              if (next === "docked") {
                slot.appendChild(visual);
                slot.classList.add("is-filled");
                visual.removeAttribute("style");
                shade.style.opacity = "0";
                dockedAt = performance.now();
                dockShrunk = featuredM >= 1;
                spread = 1;
                placeAll();
              } else {
                slot.classList.remove("is-filled");
                if (visual.parentElement !== hero) hero.prepend(visual);
                if (next === "hero") {
                  visual.removeAttribute("style");
                  shade.style.opacity = "";
                  if (!reduced) {
                    spread = SPREAD_START;
                    placeAll();
                  }
                }
              }
              state = next;
            }

            function morph() {
              if (!hero || !visual || !shade) return;
              const vh = window.innerHeight;
              const y = window.scrollY;
              const h = hero.getBoundingClientRect();
              const s = slot.getBoundingClientRect();
              const start = y + h.bottom - vh * 0.5;
              // The end point is MAIN's *settled* centre (ticker top + featured
              // centre), not its live rect — once the marquee runs, the main
              // card moves and sinks onto the arc, and that must never read
              // as the user having scrolled back up.
              const t = ticker.getBoundingClientRect();
              const end = y + t.top + MAIN_CY - vh * 0.5;
              const p =
                end > start ? clamp((y - start) / (end - start), 0, 1) : y >= end ? 1 : 0;

              if (reduced) {
                setState(p < 0.5 ? "hero" : "docked");
                return;
              }
              if (p <= 0) return setState("hero");
              if (p >= 1) return setState("docked");

              setState("moving");
              const e = ease(p);
              // Surrounding cards fan out into their settled positions in
              // step with the hero image's arrival.
              spread = lerp(SPREAD_START, 1, e);
              placeAll();
              const st = visual.style;
              st.position = "fixed";
              st.zIndex = "30";
              st.left = `${lerp(h.left, s.left, e)}px`;
              st.top = `${lerp(h.top, s.top, e)}px`;
              st.width = `${lerp(h.width, s.width, e)}px`;
              st.height = `${lerp(h.height, s.height, e)}px`;
              st.borderRadius = `${6 * e}px`;
              shade.style.opacity = `${1 - e}`;
            }

            // ── Frame loop ─────────────────────────────────────────────
            let last = performance.now();
            function frame(now: number) {
              const dt = Math.min((now - last) / 1000, 0.05);
              last = now;
              morph();
              const r = ticker.getBoundingClientRect();
              const near = r.bottom > -300 && r.top < window.innerHeight + 300;
              const offscreen = r.bottom <= 0 || r.top >= window.innerHeight;
              if (state === "docked" && !reduced && !dockShrunk) {
                // After the settle pause, MAIN eases from featured size into
                // the row. Nothing moves horizontally until this completes.
                const t = clamp((now - dockedAt - SETTLE_MS) / SHRINK_MS, 0, 1);
                const m = t * t * (3 - 2 * t);
                if (m !== featuredM) {
                  featuredM = m;
                  placeAll();
                }
              }
              // Without a hero handoff, the clock starts when the section first comes near.
              if (!visual && !dockedAt && near) dockedAt = now;
              const motionStart = dockedAt + SETTLE_MS + (dockShrunk ? 0 : SHRINK_MS);
              const settled = state === "docked" && dockedAt > 0 && now > motionStart;
              if (settled && !reduced && near && !document.hidden) {
                // Ease from rest to full speed once every card is in the row;
                // slow smoothly while hovered.
                const ramp = clamp((now - motionStart) / RAMP_MS, 0, 1);
                hover += ((hovering ? 1 : 0) - hover) * Math.min(1, dt * 6);
                advance(dt * (1 - Math.pow(1 - ramp, 3)) * lerp(1, HOVER_SLOW, hover));
              } else if (state !== "docked" && offscreen) {
                recenter();
              }
              requestAnimationFrame(frame);
            }

            let hovering = false;
            ticker.addEventListener("pointerenter", () => (hovering = true));
            ticker.addEventListener("pointerleave", () => (hovering = false));

            let resizeTimer: number | undefined;
            window.addEventListener("resize", () => {
              window.clearTimeout(resizeTimer);
              resizeTimer = window.setTimeout(build, 150);
            });

            build();
            requestAnimationFrame(frame);
