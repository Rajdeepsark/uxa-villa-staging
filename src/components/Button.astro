---
/**
 * Site-wide button. One shape/size (52px tall pill)/typography for every button;
 * only colors change per variant:
 *  - dark:  black bg, white text (navbar)
 *  - cream: warm cream bg, black text (primary CTA)
 *  - ghost: transparent bg, white text (secondary CTA on imagery)
 *  - outline: gold hairline, gold text (secondary CTA on ivory)
 */
interface Props {
  href: string;
  variant?: "dark" | "cream" | "ghost" | "outline";
  class?: string;
  target?: string;
  rel?: string;
}

const { href, variant = "dark", class: className = "", target, rel } = Astro.props;

const base =
  "group relative inline-flex h-[52px] items-center justify-center overflow-hidden rounded-full px-7 text-[12px] md:text-[12.5px] font-medium uppercase tracking-[0.12em] transition-colors";

const variants = {
  dark: "bg-forest text-ivory hover:bg-forest-soft",
  cream: "bg-cream text-forest hover:bg-cream-deep",
  ghost: "bg-transparent text-ivory/90 hover:bg-ivory/10 hover:text-ivory",
  outline: "border border-gold text-gold hover:bg-gold/10",
};
---

<a href={href} target={target} rel={rel} class={`${base} ${variants[variant]} ${className}`}>
  <span
    class="pointer-events-none flex items-center justify-center transition-transform duration-300 ease-out group-hover:-translate-y-[135%]"
  >
    <slot />
  </span>
  <span
    aria-hidden="true"
    class="pointer-events-none absolute inset-0 flex items-center justify-center translate-y-[135%] transition-transform duration-300 ease-out group-hover:translate-y-0"
  >
    <slot />
  </span>
</a>
