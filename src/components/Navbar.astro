---
/**
 * Full-width two-row navigation bar, flush to the top of the page.
 * The bar spans edge to edge; its contents align to the shared
 * 1280px container-site grid.
 *
 * Row 1 — announcement strip.
 * Row 2 — three-zone grid: links / logo / socials.
 * The logo lives in the middle grid column (1fr auto 1fr),
 * so it is mathematically centered regardless of the width
 * of the left links or the right social icons.
 *
 * Replace the contents of the "Logo" slot area below with an
 * <img> or inline <svg> to swap in a real mark.
 */
interface Props {
  announcementText?: string;
  announcementHref?: string;
}

import Button from "./Button.astro";

const {
  announcementText = "10+ Years of Luxury Hospitality",
  announcementHref = "#",
} = Astro.props;

const phone = "+91 91017 98042";

const links = [
  { label: "Our Story", href: "/#our-story" },
  { label: "Suites", href: "/#suites" },
  { label: "Contact", href: "/contact" },
];
---

<header class="relative z-50 w-full border-b border-forest/10 bg-ivory">
  <nav aria-label="Main navigation">
    <!-- Row 1 — announcement -->
    <div class="relative border-b border-forest/10">
      <a
        href={`tel:${phone.replace(/\s/g, "")}`}
        class="container-site flex h-[44px] items-center justify-center gap-1.5 text-[13px] md:text-[13.5px] tracking-[-0.01em] text-forest/80 transition-colors hover:text-forest"
      >
        <span>
          Call us at
          <span class="font-medium underline underline-offset-[3px] decoration-gold text-forest">{phone}</span>
        </span>
        <svg
          aria-hidden="true"
          class="size-3 shrink-0 text-ink-muted"
          viewBox="0 0 12 12"
          fill="none"
          stroke="currentColor"
          stroke-width="1.25"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M3.5 8.5 8.5 3.5M4.5 3.5h4v4" />
        </svg>
      </a>
    </div>

    <!-- Row 2 — main navigation: 1fr / auto / 1fr keeps the logo exactly centered -->
    <div class="container-site grid h-[58px] md:h-[66px] grid-cols-[1fr_auto_1fr] items-center">
      <!-- Left — links -->
      <ul class="flex items-center gap-4 md:gap-7 justify-self-start">
        {
          links.map((link) => (
            <li>
              <a
                href={link.href}
                class="text-[13px] md:text-[14px] tracking-[-0.02em] text-forest transition-colors hover:text-gold"
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>

      <!-- Center — logo (swap this span for an <img> or inline <svg>) -->
      <a
        href="/"
        aria-label="Home"
        class="justify-self-center select-none"
      >
        <span class="text-[19px] md:text-[22px] font-semibold tracking-[-0.03em] text-forest">
          UXA VILLA
        </span>
      </a>

      <!-- Right — socials -->
      <ul class="flex items-center gap-3 md:gap-4 justify-self-end">
        <li>
          <a
            href="https://www.instagram.com"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Instagram"
            class="block text-forest transition-colors hover:text-gold"
          >
            <svg
              aria-hidden="true"
              class="size-[17px] md:size-[18px]"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <rect x="2.5" y="2.5" width="19" height="19" rx="5" />
              <circle cx="12" cy="12" r="4.2" />
              <circle cx="17.4" cy="6.6" r="0.6" fill="currentColor" stroke="none" />
            </svg>
          </a>
        </li>
        <li>
          <a
            href="https://www.facebook.com"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Facebook"
            class="block text-forest transition-colors hover:text-gold"
          >
            <svg aria-hidden="true" class="size-[17px] md:size-[18px]" viewBox="0 0 24 24" fill="currentColor">
              <path
                d="M24 12.07C24 5.4 18.63 0 12 0S0 5.4 0 12.07C0 18.1 4.39 23.09 10.13 24v-8.44H7.08v-3.49h3.05V9.41c0-3.02 1.79-4.7 4.53-4.7 1.31 0 2.68.24 2.68.24v2.97h-1.51c-1.49 0-1.95.93-1.95 1.89v2.26h3.32l-.53 3.49h-2.79V24C18.61 23.09 24 18.1 24 12.07Z"
              />
            </svg>
          </a>
        </li>
        <li>
          <Button href="/contact" variant="dark" class="hidden sm:inline-flex">
            BOOK A CALL
          </Button>
        </li>
      </ul>
    </div>
  </nav>
</header>
