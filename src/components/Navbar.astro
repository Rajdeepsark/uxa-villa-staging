---
/**
 * Full-width single-row navigation bar, flush to the top of the page.
 * The bar spans edge to edge; its contents align to the shared
 * 1280px container-site grid.
 *
 * Three-zone grid: links / logo / phone + CTA — desktop (md+) only.
 * The logo lives in the middle grid column (1fr auto 1fr), so it stays
 * mathematically centered regardless of what the flanking columns hold.
 * Below md the flanking content is replaced by a single hamburger button
 * that opens a full-screen menu containing everything else (links, phone,
 * socials, the CTA).
 */
import Button from "./Button.astro";

const phone = "+91 91017 98042";

const links = [
  { label: "Our Story", href: "/#our-story" },
  { label: "Suites", href: "/#suites" },
  { label: "Contact", href: "/contact" },
];
---

<header class="relative z-50 w-full border-b border-forest/10 bg-ivory">
  <nav aria-label="Main navigation">
    <!-- Mobile: a plain edge-to-edge flex row (logo start, hamburger end) —
         the same positions the open mobile menu uses for its logo/close
         button, so nothing shifts when it opens or closes.
         Desktop (md+): 1fr / auto / 1fr grid keeps the logo mathematically
         centered regardless of what the flanking columns hold. -->
    <div class="container-site flex h-[68px] items-center justify-between md:grid md:h-[76px] md:grid-cols-[1fr_auto_1fr]">
      <!-- Left — links (desktop only) -->
      <ul class="hidden items-center gap-4 justify-self-start md:flex md:gap-7">
        {
          links.map((link) => (
            <li>
              <a
                href={link.href}
                class="text-[13px] md:text-[14px] tracking-[-0.02em] text-forest transition-colors hover:text-gold"
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>

      <!-- Center — logo -->
      <a href="/" aria-label="Home" class="justify-self-center select-none">
        <img src="/images/logo-dark.png" alt="UXA Villa & Homestay" class="h-[52px] w-[70px] md:h-16 md:w-[86px]" />
      </a>

      <!-- Right — desktop: socials / phone / CTA. Mobile: hamburger only. -->
      <div class="justify-self-end">
        <ul class="hidden items-center gap-3 md:flex md:gap-4">
          <li>
            <a
              href="https://www.instagram.com"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Instagram"
              class="block text-forest transition-colors hover:text-gold"
            >
              <svg
                aria-hidden="true"
                class="size-[17px] md:size-[18px]"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <rect x="2.5" y="2.5" width="19" height="19" rx="5" />
                <circle cx="12" cy="12" r="4.2" />
                <circle cx="17.4" cy="6.6" r="0.6" fill="currentColor" stroke="none" />
              </svg>
            </a>
          </li>
          <li>
            <a
              href="https://www.facebook.com"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Facebook"
              class="block text-forest transition-colors hover:text-gold"
            >
              <svg aria-hidden="true" class="size-[17px] md:size-[18px]" viewBox="0 0 24 24" fill="currentColor">
                <path
                  d="M24 12.07C24 5.4 18.63 0 12 0S0 5.4 0 12.07C0 18.1 4.39 23.09 10.13 24v-8.44H7.08v-3.49h3.05V9.41c0-3.02 1.79-4.7 4.53-4.7 1.31 0 2.68.24 2.68.24v2.97h-1.51c-1.49 0-1.95.93-1.95 1.89v2.26h3.32l-.53 3.49h-2.79V24C18.61 23.09 24 18.1 24 12.07Z"
                />
              </svg>
            </a>
          </li>
          <li class="hidden lg:block">
            <a
              href={`tel:${phone.replace(/\s/g, "")}`}
              class="ml-2 text-[13px] md:text-[14px] font-medium tracking-[-0.01em] text-forest transition-colors hover:text-gold"
            >
              {phone}
            </a>
          </li>
          <li>
            <Button href="/contact" variant="dark" class="hidden sm:inline-flex">
              BOOK A CALL
            </Button>
          </li>
        </ul>

        <!-- Hamburger — mobile only -->
        <button
          type="button"
          id="nav-menu-open"
          aria-label="Open menu"
          aria-expanded="false"
          aria-controls="nav-menu"
          class="flex h-10 w-10 items-center justify-center text-forest md:hidden"
        >
          <span class="flex w-[20px] flex-col gap-[5px]" aria-hidden="true">
            <span class="h-[1.5px] w-full bg-current"></span>
            <span class="h-[1.5px] w-full bg-current"></span>
            <span class="h-[1.5px] w-full bg-current"></span>
          </span>
        </button>
      </div>
    </div>
  </nav>

  <!-- Mobile menu — everything the collapsed bar hides (links, phone, socials, CTA) -->
  <div
    id="nav-menu"
    class="fixed inset-0 z-[100] hidden flex-col overflow-y-auto bg-ivory md:hidden"
    role="dialog"
    aria-modal="true"
    aria-label="Menu"
  >
    <div class="container-site flex h-[68px] items-center justify-between border-b border-forest/10">
      <img src="/images/logo-dark.png" alt="UXA Villa & Homestay" class="h-[52px] w-[70px]" />
      <button
        type="button"
        id="nav-menu-close"
        aria-label="Close menu"
        class="flex h-10 w-10 items-center justify-center text-forest"
      >
        <svg aria-hidden="true" class="h-5 w-5" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round">
          <path d="M3 3l14 14M17 3 3 17" />
        </svg>
      </button>
    </div>

    <ul class="container-site flex flex-col pt-8">
      {
        links.map((link) => (
          <li class="border-b border-forest/10">
            <a
              href={link.href}
              class="nav-menu-link block py-4 text-[22px] tracking-[-0.02em] text-forest transition-colors hover:text-gold"
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>

    <div class="container-site mt-auto flex flex-col gap-6 pb-10 pt-10">
      <a
        href={`tel:${phone.replace(/\s/g, "")}`}
        class="nav-menu-link text-[16px] font-medium tracking-[-0.01em] text-forest transition-colors hover:text-gold"
      >
        {phone}
      </a>
      <div class="flex items-center gap-5">
        <a
          href="https://www.instagram.com"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Instagram"
          class="block text-forest transition-colors hover:text-gold"
        >
          <svg aria-hidden="true" class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <rect x="2.5" y="2.5" width="19" height="19" rx="5" />
            <circle cx="12" cy="12" r="4.2" />
            <circle cx="17.4" cy="6.6" r="0.6" fill="currentColor" stroke="none" />
          </svg>
        </a>
        <a
          href="https://www.facebook.com"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Facebook"
          class="block text-forest transition-colors hover:text-gold"
        >
          <svg aria-hidden="true" class="size-5" viewBox="0 0 24 24" fill="currentColor">
            <path
              d="M24 12.07C24 5.4 18.63 0 12 0S0 5.4 0 12.07C0 18.1 4.39 23.09 10.13 24v-8.44H7.08v-3.49h3.05V9.41c0-3.02 1.79-4.7 4.53-4.7 1.31 0 2.68.24 2.68.24v2.97h-1.51c-1.49 0-1.95.93-1.95 1.89v2.26h3.32l-.53 3.49h-2.79V24C18.61 23.09 24 18.1 24 12.07Z"
            />
          </svg>
        </a>
      </div>
      <Button href="/contact" variant="dark" class="nav-menu-link w-full justify-center">
        BOOK A CALL
      </Button>
    </div>
  </div>
</header>

<script>
  const menu = document.getElementById("nav-menu");
  const openBtn = document.getElementById("nav-menu-open");
  const closeBtn = document.getElementById("nav-menu-close");

  function setOpen(open: boolean) {
    if (!menu || !openBtn) return;
    menu.classList.toggle("hidden", !open);
    menu.classList.toggle("flex", open);
    openBtn.setAttribute("aria-expanded", String(open));
    document.body.style.overflow = open ? "hidden" : "";
  }

  openBtn?.addEventListener("click", () => setOpen(true));
  closeBtn?.addEventListener("click", () => setOpen(false));
  menu?.querySelectorAll(".nav-menu-link").forEach((el) => el.addEventListener("click", () => setOpen(false)));
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") setOpen(false);
  });
  // If the viewport grows past the mobile breakpoint while the menu is
  // open, close it so it doesn't linger under the desktop bar.
  const mq = window.matchMedia("(min-width: 768px)");
  mq.addEventListener("change", (e) => {
    if (e.matches) setOpen(false);
  });
</script>
