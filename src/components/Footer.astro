---
/**
 * Site footer — shared by every page.
 */
---

<footer class="relative bg-forest-deep py-16 text-ivory md:py-20">
  <div
    aria-hidden="true"
    class="pointer-events-none absolute inset-0 z-10 opacity-[0.07] [background-image:radial-gradient(rgba(255,255,255,0.5)_0.5px,transparent_0.5px)] [background-size:3px_3px]"
  >
  </div>
  <div class="container-site">
    <div class="grid gap-12 md:grid-cols-12 md:gap-8">
      <!-- Brand -->
      <div class="md:col-span-4">
        <img src="/images/logo-light.png" alt="UXA Villa & Homestay" class="h-16 w-auto md:h-20" />
        <p class="mt-7 max-w-[440px] text-[15px] leading-relaxed tracking-[-0.02em] text-ivory/75">
          A comfortable 4BHK villa homestay in Tezpur, Assam, with four
          bedrooms, four bathrooms and space for up to eight guests.
        </p>
      </div>

      <!-- Discover -->
      <nav aria-label="Discover" class="md:col-span-2 md:col-start-6">
        <p class="text-[11px] font-medium uppercase tracking-[0.28em] text-gold-light">Discover</p>
        <ul class="mt-5 space-y-3.5">
          <li><a href="/#stay-overview" class="text-[14px] font-medium tracking-[-0.01em] text-ivory/85 transition-colors hover:text-gold-light">The Stay</a></li>
          <li><a href="/#amenities" class="text-[14px] font-medium tracking-[-0.01em] text-ivory/85 transition-colors hover:text-gold-light">Amenities</a></li>
          <li><a href="/#testimonials" class="text-[14px] font-medium tracking-[-0.01em] text-ivory/85 transition-colors hover:text-gold-light">Reviews</a></li>
          <li><a href="/contact" class="text-[14px] font-medium tracking-[-0.01em] text-ivory/85 transition-colors hover:text-gold-light">Contact</a></li>
        </ul>
      </nav>

      <!-- Reach us -->
      <div class="md:col-span-3 md:col-start-10">
        <p class="text-[11px] font-medium uppercase tracking-[0.28em] text-gold-light">Reach Us</p>
        <ul class="mt-5 space-y-3.5">
          <li>
            <a href="tel:+919101798042" class="flex items-center gap-3 text-[14px] font-medium tracking-[-0.01em] text-ivory/85 transition-colors hover:text-gold-light">
              <svg aria-hidden="true" class="size-[15px] shrink-0 text-gold-light/80" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2Z"/></svg>
              +91 91017 98042
            </a>
          </li>
          <li>
            <a href="https://wa.me/919101798042" target="_blank" rel="noopener noreferrer" class="flex items-center gap-3 text-[14px] font-medium tracking-[-0.01em] text-ivory/85 transition-colors hover:text-gold-light">
              <svg aria-hidden="true" class="size-[15px] shrink-0 text-gold-light/80" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M4 20l1.3-3.8A8 8 0 1 1 8.3 19L4 20Z"/><path d="M9.5 9.5c0 3 2 5 5 5l1-1.5-2-1-.8.8a4 4 0 0 1-1.8-1.8l.8-.8-1-2-1.2 1.3Z"/></svg>
              Message on WhatsApp
            </a>
          </li>
          <li>
            <a href="mailto:concierge@uxavilla.com" class="flex items-center gap-3 text-[14px] font-medium tracking-[-0.01em] text-ivory/85 transition-colors hover:text-gold-light">
              <svg aria-hidden="true" class="size-[15px] shrink-0 text-gold-light/80" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg>
              concierge@uxavilla.com
            </a>
          </li>
          <li>
            <a href="https://www.instagram.com/uxa_villa/" target="_blank" rel="noopener noreferrer" class="flex items-center gap-3 text-[14px] font-medium tracking-[-0.01em] text-ivory/85 transition-colors hover:text-gold-light">
              <svg aria-hidden="true" class="size-[15px] shrink-0 text-gold-light/80" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.3" cy="6.7" r="0.7" fill="currentColor" stroke="none"/></svg>
              @uxa_villa
            </a>
          </li>
        </ul>
      </div>
    </div>

    <div class="mt-14 flex flex-wrap items-center justify-between gap-4 pt-6 md:mt-16">
      <p class="text-[13px] tracking-[-0.01em] text-ivory/60">
        &copy; 2026 UXA Villa &amp; Homestay. All rights reserved.
      </p>
      <div class="flex flex-wrap items-center gap-8 text-[11px] font-medium uppercase tracking-[0.2em] text-ivory/45 md:gap-10">
        <span>Designed by Poroflo</span>
        <span>Tezpur &middot; Assam &middot; India</span>
      </div>
    </div>
  </div>
</footer>
