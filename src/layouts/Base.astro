---
/**
 * Page shell shared by every route: document head (fonts, meta),
 * the navigation bar, the page content, and the footer.
 */
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = "UXA Villa & Homestay — a comfortable 3BHK villa homestay in Tezpur, Assam for families, friends and group stays.",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Geist:wght@300;400;500;600&family=EB+Garamond:wght@400;500;600&display=swap"
    />
  </head>
  <body class="min-h-screen bg-ivory font-sans antialiased">
    <div class="relative">
      <Navbar />
      <slot />
      <Footer />
    </div>
  </body>
</html>
